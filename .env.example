# Flask セッション用シークレットキー
APP_SECRET_KEY=your-random-secret-key-here

# Google サービスアカウント（JSONキー文字列）
# Google Cloud Console でサービスアカウントを作成し、JSONキーをダウンロード後、
# その内容を1行にして貼り付ける
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"...@...iam.gserviceaccount.com",...}

# ローカル開発用: JSONキーファイルのパス（上記環境変数が未設定の場合のフォールバック）
# GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
